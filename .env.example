# Copie este arquivo para ".env" (dev local) e preencha com os valores do
# seu projeto Supabase: Project Settings → API.
#
# ATENÇÃO: use sempre a chave "anon / public" aqui. NUNCA coloque a chave
# "service_role" neste arquivo nem em nenhuma variável VITE_* — ela dá acesso
# total ao banco e não pode ser exposta no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
